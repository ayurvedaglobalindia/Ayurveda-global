# ==============================================================================
# AYUR VEDA GLOBAL - ENVIRONMENT VARIABLES
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT CONFIGURATION (Safe to expose in browser)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://ayurvedaglobal.com"
NEXT_PUBLIC_SITE_NAME="Ayur Veda Global"
NEXT_PUBLIC_WHATSAPP_NUMBER="919123485451"

# Shipping (in paise: ₹49 flat, free delivery on orders ₹999 and above)
NEXT_PUBLIC_SHIPPING_FLAT_RATE=4900
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=99900


# ------------------------------------------------------------------------------
# 2. SECURE SERVERLESS OTP GATEWAY SECRETS (Cloudflare Pages Functions)
# IMPORTANT: DO NOT add NEXT_PUBLIC_ prefix to these variables!
# These must ONLY be set in Cloudflare Pages Dashboard -> Settings -> Environment Variables.
# ------------------------------------------------------------------------------

# Master Toggle: Set to "true" during development to trigger ZERO SMS costs.
# Set to "false" in Production to dispatch live SMS to Indian mobile numbers.
OTP_TEST_MODE="true"

# Provider Selector: "2factor" (Recommended for India) or "fast2sms"
OTP_PROVIDER="2factor"

# Option A: 2Factor.in (Recommended - Instant transactional DLT routes)
# Sign up at https://2factor.in -> API Keys -> Copy Key -> Encrypt as Secret
TWOFACTOR_API_KEY="your-2factor-api-key-here"

# Option B: Fast2SMS (Alternative Indian SMS Provider)
# Sign up at https://fast2sms.com -> Dev API -> Copy Key -> Encrypt as Secret
# FAST2SMS_API_KEY="your-fast2sms-api-key-here"

# Cryptographic salt for signing verification receipts (optional, auto-generated if omitted)
# OTP_SECRET="a-random-high-entropy-secret-string-here"

# ------------------------------------------------------------------------------
# 3. FIREBASE CLIENT CONFIGURATION (Phone Auth SMS OTP Verification)
# From Firebase Console -> Project Settings -> General -> Your Apps (Web App)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="ayurveda-global.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="ayurveda-global"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="ayurveda-global.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY & UPI CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
NEXT_PUBLIC_UPI_VPA="ayurvedaglobal@icici"

# Cashfree Payments (v2025-01-01 / v3 SDK)
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_ENV="TEST" # TEST (sandbox) or PROD (production)
NEXT_PUBLIC_CASHFREE_ENV="TEST"

# ------------------------------------------------------------------------------
# 5. SUPABASE POSTGRESQL & AUTH CONFIGURATION
# Copy from Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

